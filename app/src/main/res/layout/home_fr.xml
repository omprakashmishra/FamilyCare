<RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:visibility="visible"
    >

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        app:srcCompat="@color/colorPrimary"
        tools:ignore="UnknownId" />

    <LinearLayout
        android:id="@+id/LL_toplayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        >

        <RelativeLayout
            android:layout_width="110dp"
            android:layout_height="110dp" >
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/CIV_profileDp"
                android:layout_width="110dp"
                android:layout_height="110dp"
                app:civ_border_color="@color/white"
                app:civ_border_width="4dp"
                android:src="@drawable/teacher_fml" />

            <ProgressBar
                android:id="@+id/mprogressBar"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:indeterminateDrawable="@drawable/circular_progressbar"
                android:visibility="visible"></ProgressBar>
        </RelativeLayout>


        <TextView
            android:id="@+id/TV_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:layout_marginTop="5dp"
            android:textAllCaps="true"
            android:visibility="gone"
            android:textSize="15dp"
            android:text="Name" />

        <TextView
            android:id="@+id/TV_roleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12dp"
            android:visibility="gone"
            android:layout_marginTop="2dp"
            android:text="dfasfd" />

        <TextView
            android:id="@+id/TV_org"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:padding="5dp"
            android:textSize="12dp"
            android:visibility="gone"
            android:text="Organization Name" />

        <RelativeLayout
            android:layout_width="185dp"
            android:layout_height="35dp"
            android:background="@drawable/rectangular_white"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginTop="7dp"
            >

            <Switch
                android:id="@+id/SW_safeJone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/IV_info"
                android:layout_toLeftOf="@+id/IV_info"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:textColor="@color/dark_red"
                android:textStyle="bold"
                android:text="Become Safe"/>
            <ImageView
                android:id="@+id/IV_info"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/info_icon"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/LL_toplayout"
      >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:id="@+id/linearLayout1"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                >

                <RelativeLayout
                    android:id="@+id/RL_post"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#E5F8FF"
                   >

                    <ImageView
                        android:id="@+id/IV_gifimg"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/TV_totalTeachers"
                        android:text="Shared Contact"
                        android:textAlignment="center"
                        android:textColor="@color/darkgrey"
                        android:textSize="@dimen/body"
                        />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/RL_location"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#EE9918">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/google_map_ic"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/TV_DriversTtl"
                        android:text="Find"
                        android:textAlignment="center"
                        android:textColor="@color/darkgrey"
                        android:textSize="@dimen/body"
                        />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/RL_newsNoti_Ttl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#68b4cf">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/alarm_icon"
                        android:tint="@color/darkgrey"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/TV_newsNoti_Ttl"
                        android:text="Updates"
                        android:textAlignment="center"
                        android:textColor="@color/darkgrey"
                        android:textSize="@dimen/body"
                        />

                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:id="@+id/linearLayout2"
                android:layout_below="@+id/linearLayout1"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                >

                <RelativeLayout
                    android:id="@+id/RL_curentdate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#8ED306">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/doorbell_ic"
                        android:tint="@color/darkgrey"/>
                    <TextView
                        android:id="@+id/TV_curentdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textStyle="bold"
                        android:maxLength="2"
                        android:layout_centerVertical="true"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        />
                    <TextView
                        android:id="@+id/TV_monthYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:text="DoorBell"
                        android:textAlignment="center"
                        android:textSize="@dimen/body"
                        android:textColor="@color/darkgrey"
                        />

                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/RL_addFamily"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:layout_weight="1"
                    >
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/plus_black_ic"
                        android:tint="@color/white"
                        android:background="@drawable/circular_bg"
                        android:backgroundTint="@color/colorPrimary"
                      />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/TV_students_Ttl"
                        android:text="Members"
                        android:textAlignment="center"
                        android:textSize="@dimen/body"
                        android:textColor="@color/darkgrey"
                        />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/RL_diary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#8ED306">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/diary_ic"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:tint="@color/darkgrey"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:textSize="@dimen/body"
                        android:text="Notes"
                        android:textAlignment="center"
                        android:textColor="@color/darkgrey"
                        />

                </RelativeLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                >

                <RelativeLayout
                    android:id="@+id/RL_trackingGuard"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:background="#E5F8FF">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/track"
                        android:tint="@color/darkgrey"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/TV_tracking"
                        android:text="Track"
                        android:textAlignment="center"
                        android:textSize="@dimen/body"
                        android:textColor="@color/darkgrey"
                        />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/RL_shopping"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:visibility="visible"
                    android:background="#68b4cf"
                  >

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/shopping_ic"
                        android:tint="@color/darkgrey"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/TV_shopping"
                        android:text="Family Need"
                        android:textAlignment="center"
                        android:textSize="@dimen/body"
                        android:textColor="@color/darkgrey"
                        />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/RL_manageProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#EE9918">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/profile_edit"
                        android:tint="@color/darkgrey"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/TV_manageVehicle"
                        android:text="My Profile"
                        android:textAlignment="center"
                        android:textColor="@color/darkgrey"
                        android:textSize="@dimen/body"
                        />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/RL_Help"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#E5F8FF"
                    >

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:src="@drawable/all_in_one_ic"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:id="@+id/TV_manage_guard"
                        android:text="Help"
                        android:textAlignment="center"
                        android:textColor="@color/darkgrey"
                        android:visibility="gone"
                        android:textSize="@dimen/body"
                        />

                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</RelativeLayout>
