<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- ==================== LEFT (RECEIVED) ==================== -->
    <LinearLayout
        android:id="@+id/LL_chat_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:baselineAligned="false">

            <!-- Avatar -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/IV_left_frinds_img"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="top"
                android:src="@drawable/teacher_fml"
                app:civ_border_color="@color/white"
                app:civ_border_width="1dp" />

            <!-- Bubble — 5dp below the top of the avatar row -->
            <TextView
                android:id="@+id/TV_leftChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/chat_bubble_received"
                android:maxWidth="280dp"
                android:minHeight="32dp"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="Hello"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="5dp"
                android:lineSpacingMultiplier="1.2"
                android:letterSpacing="0.02"
                android:textColor="@color/chat_bubble_received_text"
                />
        </LinearLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/TV_left_datetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:text="10:30 AM"
            android:textColor="@color/black_light"
            android:textSize="8sp" />
    </LinearLayout>

    <!-- ==================== RIGHT (SENT) ==================== -->
    <LinearLayout
        android:id="@+id/LL_chat_right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top|end"
            android:baselineAligned="false">

            <!-- Bubble — 5dp below the top of the avatar row -->
            <TextView
                android:id="@+id/TV_rightChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/chat_bubble_sent"
                android:maxWidth="280dp"
                android:minHeight="32dp"
                android:gravity="center_vertical|start"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="5dp"
                android:lineSpacingMultiplier="1.2"
                android:letterSpacing="0.02"
                android:text="Hi there"
                android:textColor="@color/chat_bubble_received_text" />

        </LinearLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/TV_right_datetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:text="10:31 AM"
            android:textColor="@color/black_light"
            android:textSize="8sp" />
    </LinearLayout>
</LinearLayout>