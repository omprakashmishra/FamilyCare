<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical">



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
         >

        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/profile_bg" />

        <RelativeLayout
            android:id="@+id/RL_top"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/layerdark">


            <ImageView
                android:id="@+id/ic_search"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:padding="5dp"
                android:src="@drawable/ic_search"
                android:tint="@color/white"
                android:layout_centerVertical="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true" />

            <EditText
                android:id="@+id/TV_search"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:background="@drawable/rectangular_white"
                android:gravity="center"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:hint="Search"
                android:singleLine="true"
                android:textColor="@color/theme_dark"
                android:textColorHint="@color/brown"
                android:layout_marginRight="50dp"
                android:textSize="14dp"
                android:layout_alignTop="@+id/ic_search"
                android:layout_toRightOf="@+id/ic_search"
                android:layout_toEndOf="@+id/ic_search" />

            <ImageView
                android:id="@+id/IV_shrt"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:padding="5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/sorting_ic"
                android:tint="@color/white"
                android:layout_alignTop="@+id/TV_search"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true" />



        </RelativeLayout>

        <ProgressBar
            android:id="@+id/mprogressBar"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerInParent="true"
            android:indeterminateDrawable="@drawable/circular_progressbar"
            android:visibility="visible"></ProgressBar>
        <android.support.v7.widget.RecyclerView
            android:id="@+id/RV_Friends"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/RL_top"

            />

    </RelativeLayout>




</LinearLayout>
