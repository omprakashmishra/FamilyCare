<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rectangular_border"
    android:orientation="vertical"
    android:layout_margin="20dp"
    android:padding="@dimen/margin_10dp"
    android:weightSum="10">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="9.5"
        android:orientation="vertical">

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/theme_color"
            android:text="guuighiuhy9"
            android:textAlignment="center"
            android:padding="5dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_14sp" />
        <EditText
            android:id="@+id/ET_finalPrc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="Total Price 00.0"
            android:padding="5dp"
            android:textAlignment="center"
            android:textColor="@color/dark_red"
            android:textColorHint="@color/dark_red"
            android:textSize="@dimen/head"
            android:visibility="visible"
            android:drawableLeft="@drawable/money_ic"
            android:paddingLeft="45dp"
            android:layout_gravity="center_horizontal"
            />
       <include layout="@layout/custom_edit_textview"/>



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="visible"
         >

        <TextView
            android:id="@+id/no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="@dimen/margin_40dp"
            android:background="@color/white"
            android:text="cancel"
            android:textAlignment="center"
            android:textColor="@color/brown"
            android:textSize="12dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center"
            android:background="@color/white"
            android:text="Save"
            android:textColor="@color/brown"
            android:textSize="12dp"
            android:visibility="visible" />
    </LinearLayout>

</LinearLayout>