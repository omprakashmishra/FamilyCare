<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/appbg"
        android:orientation="vertical">
        <!-- android:background="@drawable/appbg"-->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margin_5dp"
            android:text="REGISTRATION"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_12sp"
            android:textStyle="bold" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"

            android:background="@drawable/myrect"
            android:elevation="15dp"></View>

        <EditText
            android:id="@+id/edt_username"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_40dp"
            android:layout_marginLeft="@dimen/margin_15dp"
            android:layout_marginRight="@dimen/margin_15dp"
            android:textColor="@color/white"
            android:textColorHint="@color/white_fade"
            android:layout_marginTop="@dimen/margin_20dp"
            android:background="@drawable/rounded_border"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:hint="Your full name"
            android:imeOptions="actionNext"
            android:inputType="textNoSuggestions"
            android:maxLength="18"
            android:paddingLeft="@dimen/margin_10dp"
            android:singleLine="true"
            android:textSize="@dimen/text_size_12sp" />

        <EditText
            android:id="@+id/edt_email"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_40dp"
            android:layout_marginLeft="@dimen/margin_15dp"
            android:layout_marginRight="@dimen/margin_15dp"
            android:layout_marginTop="@dimen/margin_12dp"
            android:background="@drawable/rounded_border"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:hint="Email ( optional )"
            android:textColor="@color/white"
            android:textColorHint="@color/white_fade"
            android:imeOptions="actionNext"
            android:inputType="textWebEmailAddress"
            android:paddingLeft="@dimen/margin_10dp"
            android:singleLine="true"
            android:textSize="@dimen/text_size_12sp" />

        <EditText
            android:id="@+id/edt_fname"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_40dp"
            android:layout_marginLeft="@dimen/margin_15dp"
            android:layout_marginRight="@dimen/margin_15dp"
            android:layout_marginTop="@dimen/margin_12dp"
            android:background="@drawable/rounded_border"
            android:hint="First Name"
            android:paddingLeft="@dimen/margin_10dp"
            android:singleLine="true"
            android:textSize="@dimen/text_size_12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/edt_lname"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_40dp"
            android:layout_marginLeft="@dimen/margin_15dp"
            android:layout_marginRight="@dimen/margin_15dp"
            android:layout_marginTop="@dimen/margin_12dp"
            android:background="@drawable/rounded_border"
            android:hint="Last Name"
            android:paddingLeft="@dimen/margin_10dp"
            android:singleLine="true"
            android:textSize="@dimen/text_size_12sp"
            android:visibility="gone" />

        <LinearLayout
android:background="@drawable/rounded_border"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_40dp"
            android:layout_marginLeft="@dimen/margin_15dp"
            android:layout_marginRight="@dimen/margin_15dp"
            android:layout_marginTop="@dimen/margin_12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="2">

            <EditText
                android:id="@+id/county_code"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/margin_40dp"
                android:background="@null"
                android:hint=""
                android:inputType="phone"
                android:paddingLeft="@dimen/margin_10dp"
                android:singleLine="true"
                android:textSize="@dimen/text_size_12sp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/SP_Countrycode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone" />

            <EditText
                android:id="@+id/edt_mobile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
               android:textAlignment="center"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Mobile Number"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLength="10"
                android:textColor="@color/white"
                android:textColorHint="@color/white_fade"
                android:singleLine="true"
                android:textSize="@dimen/text_size_12sp" />


        </LinearLayout>


        <EditText
            android:id="@+id/edt_password"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_40dp"
            android:layout_marginLeft="@dimen/margin_15dp"
            android:layout_marginRight="@dimen/margin_15dp"
            android:layout_marginTop="@dimen/margin_12dp"
            android:background="@drawable/rounded_border"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:textColor="@color/white"
            android:textColorHint="@color/white_fade"
            android:hint="Password"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:paddingLeft="@dimen/margin_10dp"
            android:singleLine="true"
            android:textSize="@dimen/text_size_12sp" />


        <EditText
            android:id="@+id/edt_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_40dp"
            android:layout_marginLeft="@dimen/margin_15dp"
            android:layout_marginRight="@dimen/margin_15dp"
            android:layout_marginTop="@dimen/margin_12dp"
            android:background="@drawable/rounded_border"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:hint="Confirm Password"
            android:imeOptions="actionNext"
            android:textColor="@color/white"
            android:textColorHint="@color/white_fade"
            android:inputType="textPassword"
            android:paddingLeft="@dimen/margin_10dp"
            android:singleLine="true"
            android:textSize="@dimen/text_size_12sp" />


        <LinearLayout
            android:id="@+id/guardlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_15dp"
            android:layout_marginRight="@dimen/margin_15dp"
            android:layout_marginTop="@dimen/margin_10dp"
            android:background="@drawable/rounded_border"
            android:visibility="gone">

            <CheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_5dp"
                android:layout_marginRight="@dimen/margin_5dp"
                android:text="Select if you are a Guard"
                android:textSize="@dimen/text_size_12sp">

            </CheckBox>
        </LinearLayout>

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_15dp"
            android:layout_marginRight="@dimen/margin_15dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/rounded_border"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:visibility="gone"
                android:text="If you are registering as an Emergency Contact, please select the option below."
                android:textSize="11dp" />

            <CheckBox
                android:id="@+id/CK_invitee"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/margin_2dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:visibility="gone"
                android:text="Emergency Contact "
                android:textColor="@color/black" />

            <LinearLayout
                android:id="@+id/LL_invitation_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="3dp"
                android:layout_marginTop="3dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/margin_35dp"
                    android:layout_marginLeft="@dimen/margin_10dp"
                    android:layout_marginRight="@dimen/margin_10dp"
                    android:layout_weight="1"
                    android:background="#CCD7DD"
                    android:padding="@dimen/margin_5dp">

                    <EditText
                        android:id="@+id/eTOne"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/margin_35dp"
                        android:layout_gravity="center"
                        android:background="@null"
                        android:gravity="center"
                        android:hint="Invitation Code"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="6"
                        android:maxLines="1"
                        android:selectAllOnFocus="true"
                        android:textColor="#575C60"
                        android:textColorHint="#575C60"
                        android:textSize="@dimen/text_size_12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:visibility="visible">

            <CheckBox
                android:id="@+id/subscription_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_above="@+id/btn_subscribe"
                android:layout_marginLeft="@dimen/margin_15dp"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/tvTermsconditions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/btn_subscribe"
                android:layout_toRightOf="@+id/subscription_checkbox"
                android:gravity="left|center"
                android:text="@string/Terms_and_Conditions"
                android:textColor="@color/theme_color"
                android:textSize="@dimen/text_size_10sp"
                android:textStyle="italic"
                android:visibility="visible"/>

            <Button
                android:id="@+id/btn_subscribe"
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_45dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="@dimen/margin_20dp"
                android:layout_marginLeft="@dimen/margin_15dp"
                android:layout_marginRight="@dimen/margin_15dp"
                android:background="@color/theme_color"
                android:imeOptions="actionDone"
                android:text="Register"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/margin_14dp"
                android:visibility="visible" />
        </RelativeLayout>

    </LinearLayout>


</ScrollView>