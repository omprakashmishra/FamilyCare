<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sliding_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/grocery_bg"
    android:orientation="vertical"
    android:paddingTop="2dp">


    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginBottom="10dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:background="@color/white_fade"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="2dp"
                        android:layout_marginTop="@dimen/margin_20dp"
                        android:background="@color/theme_dark">


                        <ImageView
                            android:id="@+id/IV_backDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="15dp"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_backarrow" />

                        <TextView
                            android:id="@+id/TV_dateTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="Today"
                            android:textColor="@color/white"
                            android:textSize="25dp" />

                        <ImageView
                            android:id="@+id/IV_forwordDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingRight="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/right_arrow_icon"
                            android:visibility="visible" />
                    </RelativeLayout>

                </RelativeLayout>

                <android.support.v7.widget.RecyclerView
                    android:id="@+id/RV_groceryList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >

                </android.support.v7.widget.RecyclerView>



            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginTop="2dp"

                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/theme_dark"
                    android:gravity="left|center_vertical">

                    <ImageView
                        android:id="@+id/IV_barcode"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_margin="3dp"

                        android:background="@drawable/border"
                        android:backgroundTint="@color/white"
                        android:padding="3dp"
                        android:src="@drawable/barcode_ic"
                        android:tint="@color/white"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/TV_headTest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/IV_barcode"
                        android:layout_toRightOf="@+id/IV_barcode"
                        android:text="Scan Item."
                        android:textColor="@color/white"
                        android:visibility="visible" />

                    <ProgressBar
                        android:id="@+id/mprogressBar"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerInParent="true"
                        android:indeterminateDrawable="@drawable/circular_progressbar"
                        android:visibility="visible"></ProgressBar>

                    <ImageView
                        android:id="@+id/IV_more"
                        android:layout_width="50dp"
                        android:layout_height="30dp"
                        android:paddingLeft="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_toStartOf="@+id/TV_shop_unshop"
                        android:src="@drawable/menu_ic"
                        android:tint="@color/white"
                        android:layout_toLeftOf="@+id/TV_shop_unshop" />
                    <TextView
                        android:id="@+id/TV_shop_unshop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_alignTop="@+id/TV_headTest"
                        android:background="@drawable/one_side_round_button"
                        android:paddingBottom="4dp"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:paddingTop="4dp"
                        android:text="shop now"
                        android:textColor="@color/black" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0.5dp"
                    android:background="@color/white">

                    <TextView
                        android:id="@+id/TV_addGrocery"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_margin="5dp"
                        android:background="@drawable/ok_green"
                        android:gravity="center"
                        android:padding="3dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text=""
                        android:textColor="@color/white"
                        android:textSize="13dp"
                        android:textStyle="bold" />


                    <EditText
                        android:id="@+id/ET_finalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Total Price 00.0"
                        android:padding="5dp"
                        android:textAlignment="center"
                        android:textColor="@color/dark_red"
                        android:textColorHint="@color/dark_red"
                        android:textSize="@dimen/head"
                        android:visibility="gone"
                        android:drawableLeft="@drawable/money_ic"
                        android:paddingLeft="45dp"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true" />

                    <view xmlns:android="http://schemas.android.com/apk/res/android"
                        android:id="@+id/body"
                        class="com.omsworld.familycare.setting.LineEditText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/toplayout"
                        android:layout_marginRight="40dp"
                        android:autoLink="web"
                        android:background="@android:color/transparent"
                        android:capitalize="sentences"
                        android:fadingEdge="vertical"
                        android:gravity="top"
                        android:hint="Add Item For Shopping"
                        android:minHeight="35dp"
                        android:overScrollMode="always"
                        android:padding="5dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:scrollbarStyle="insideInset"
                        android:scrollbars="vertical"
                        android:textColor="@color/black"
                        android:textColorHint="@color/brown"
                        android:textColorLink="@color/theme_color"
                        android:textSize="15sp"
                        android:inputType="textShortMessage"
                        android:visibility="visible" />


                </RelativeLayout>

            </LinearLayout>
        </LinearLayout>

    </android.support.v4.widget.NestedScrollView>

    <ImageView
        android:id="@+id/IV_share_item"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentRight="true"
        android:layout_marginRight="3dp"
        android:background="@drawable/circular_bg"
        android:backgroundTint="@color/theme_dark"
        android:padding="5dp"
        android:src="@drawable/icon_share" />
</RelativeLayout>