<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9C7"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_head"
            android:layout_width="fill_parent"
            android:layout_height="35dp"
            android:background="@drawable/notetop"
            android:paddingTop="5dp"
            android:paddingBottom="4dp"
            android:text="Notes"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textColor="@color/theme_dark"
            android:drawableRight="@drawable/arrow_head_down_ic"
            android:textSize="@dimen/head"
            android:textStyle="bold" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RV_diary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btmLayout"
            android:layout_below="@+id/tv_head"
            android:scrollbars="vertical" />

        <ImageView
            android:id="@+id/IV_add_new"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_margin="25dp"
            android:background="@drawable/circular_bg"
            android:padding="3dp"
            android:src="@drawable/plus_black_ic"
            android:tint="@color/white" />

    </RelativeLayout>

    <ProgressBar
        android:id="@+id/mprogressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerInParent="true"
        android:indeterminateDrawable="@drawable/circular_progressbar"
        android:visibility="visible"></ProgressBar>

</RelativeLayout>