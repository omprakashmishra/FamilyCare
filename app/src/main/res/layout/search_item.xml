<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="75dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="1dp"
    android:id="@+id/RL_row"
    android:background="@drawable/layer"
    android:paddingTop="5dp"
    android:paddingRight="5dp"
    android:paddingLeft="5dp">

    <TextView
        android:id="@+id/TV_cat_img"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:text="1"
        android:textColor="@color/white"
        android:textAllCaps="true"
        android:maxLength="1"
        android:textSize="20dp"
        android:gravity="center"
        android:textStyle="bold"
        android:background="@drawable/circular_bg"
        android:visibility="gone"/>

     <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/IV_cat_img"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:src="@mipmap/ic_launcher"
        android:padding="3dp"
         app:civ_border_width="0.5dp"
         app:civ_border_color="@color/white"
         android:background="@drawable/circular_bg"
        android:backgroundTint="@color/white"/>

    <TextView
        android:id="@+id/TV_cat_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Text"
        android:layout_marginLeft="15dp"
        android:textColor="@color/theme_dark"
        android:layout_marginTop="14dp"
        android:layout_toRightOf="@+id/IV_cat_img"
        android:layout_toEndOf="@+id/IV_cat_img" />

   <LinearLayout
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_below="@+id/TV_cat_text"
       android:layout_alignLeft="@+id/TV_cat_text"
       android:layout_alignStart="@+id/TV_cat_text"
       android:orientation="horizontal"
       android:id="@+id/linearLayout3">
       <TextView
           android:id="@+id/TV_phone"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="8802455031"
           android:textAlignment="center"
           android:textColor="@color/darkgrey"
           android:textSize="10dp"
           />
       <TextView

           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text=" added by "
           android:textAlignment="center"
           android:textColor="@color/darkgrey"
           android:textSize="10dp"
           />
       <TextView
           android:id="@+id/TV_added_by"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:textAlignment="center"
           android:singleLine="true"
           android:maxLength="20"
           android:textColor="@color/black"
           android:textAllCaps="true"
           android:textSize="10dp"
           />

   </LinearLayout>

    <TextView
        android:id="@+id/TV_added_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TV_added_date"
        android:textColor="@color/brown"
        android:textSize="10dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">


        <ImageView
            android:id="@+id/IV_message"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="5dp"
            android:visibility="visible"
            android:src="@drawable/icon_share"
            android:tint="@color/darkorange"
            />

        <ImageView
            android:id="@+id/IVCall"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="5dp"
            android:tint="@color/theme_dark"
            android:src="@drawable/ic_phone"
            />

        <ImageView
            android:id="@+id/IV_edit"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:padding="5dp"
            android:visibility="visible"
            android:src="@drawable/pen_ic"
            android:layout_gravity="center"
            android:background="@drawable/circular_bg"
            />

        <ImageView
            android:id="@+id/shareText"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="5dp"
            android:visibility="gone"


            />

        <ImageView
            android:id="@+id/IV_Likelike"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:padding="5dp"
            android:visibility="gone"

            />

    </LinearLayout>

    <ImageView
        android:id="@+id/IV_Dislike"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:padding="5dp"
        android:visibility="gone"

        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/IV_cat_img"
        android:layout_centerHorizontal="true">

        <TextView
            android:id="@+id/TV_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TV_comment"
            android:textAlignment="center"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:paddingBottom="2dp"
            android:textColor="@color/brown"
            android:textSize="10dp"  />
    </RelativeLayout>

</RelativeLayout>
